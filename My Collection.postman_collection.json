  },
  "item": [
    {
      "name": "Register Passenger",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Passenger\",\n  \"email\": \"alice.passenger@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"PASSENGER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5001/api/accounts/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "api",
            "accounts",
            "register"
          ]
        }
      },
      "response": []
    },
